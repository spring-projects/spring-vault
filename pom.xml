<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.springframework.vault</groupId>
	<artifactId>spring-vault-parent</artifactId>
	<version>4.0.1-SNAPSHOT</version>

	<name>Spring Vault</name>
	<description>Parent project for Spring Vault</description>
	<packaging>pom</packaging>

	<url>https://projects.spring.io/spring-vault/</url>

	<modules>
		<module>spring-vault-core</module>
		<module>spring-vault-distribution</module>
	</modules>

	<properties>
		<maven.antora-version>1.0.0-alpha.5</maven.antora-version>
		<antora.version>0.0.4</antora.version>
		<assertj-core.version>3.27.7</assertj-core.version>
		<aws-java-sdk.version>2.46.21</aws-java-sdk.version>
		<bcpkix-jdk18on.version>1.84</bcpkix-jdk18on.version>
		<errorprone.version>2.42.0</errorprone.version>
		<google-cloud-iamcredentials.version>2.93.0</google-cloud-iamcredentials.version>
		<google-auth-library-oauth2-http.version>1.48.0</google-auth-library-oauth2-http.version>
		<httpclient5.version>5.6.4</httpclient5.version>
		<httpcore5.version>5.4.3</httpcore5.version>
		<jackson-annotations.version>2.22</jackson-annotations.version>
		<jackson-core.version>3.1.5</jackson-core.version>
		<jackson-databind.version>3.1.5</jackson-databind.version>
		<jackson2-databind.version>2.21.6</jackson2-databind.version>
		<jetty-reactive-httpclient.version>4.1.5</jetty-reactive-httpclient.version>
		<json-path.version>3.0.0</json-path.version>
		<jspecify.version>1.0.0</jspecify.version>
		<junit.version>6.1.2</junit.version>
		<kotlin.version>2.3.21</kotlin.version>
		<kotlin-coroutines.version>1.10.2</kotlin-coroutines.version>
		<mockk.version>1.14.11</mockk.version>
		<mockito-core.version>5.23.0</mockito-core.version>
		<nullaway.version>0.13.1</nullaway.version>
		<okhttp3.version>5.4.0</okhttp3.version>
		<spring.version>7.0.8</spring.version>
		<spring-data-bom.version>2026.0.0</spring-data-bom.version>
		<spring-security-bom.version>7.1.0</spring-security-bom.version>
		<reactor.version>2025.0.6</reactor.version>
		<reactive-streams.version>1.0.4</reactive-streams.version>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>17</java.version>
		<project.type>multi</project.type>
		<dist.id>spring-vault</dist.id>
		<project.root>${basedir}</project.root>
		<shared.resources>${project.build.directory}/shared-resources</shared.resources>
		<doc.resources>${project.build.directory}/doc-resources</doc.resources>

		<!-- To be overridden by individual modules -->
		<java-module-name/>

		<!-- Documentation -->
		<!-- @formatter:off -->
		<documentation.baseurl>https://docs.spring.io</documentation.baseurl>
		<documentation.spring-reference-url>${documentation.baseurl}/spring-framework/reference</documentation.spring-reference-url>
		<documentation.spring-javadoc-url>${documentation.baseurl}/spring-framework/docs/${spring.version}/javadoc-api</documentation.spring-javadoc-url>
		<documentation.spring-data-commons-url>${documentation.baseurl}/spring-data/commons/reference/api/java</documentation.spring-data-commons-url>
		<documentation.spring-data-keyvalue-url>${documentation.baseurl}/spring-data/keyvalue/reference/api/java</documentation.spring-data-keyvalue-url>
		<documentation.reactor-javadoc-url>https://projectreactor.io/docs/core/release/api</documentation.reactor-javadoc-url>
		<documentation.reactive-streams-javadoc-url>https://www.reactive-streams.org/reactive-streams-${reactive-streams.version}-javadoc</documentation.reactive-streams-javadoc-url>
		<documentation.jackson2-core-javadoc-url>https://javadoc.io/doc/com.fasterxml.jackson.core/jackson-core/${jackson2-databind.version}</documentation.jackson2-core-javadoc-url>
		<documentation.jackson2-databind-javadoc-url>https://javadoc.io/doc/com.fasterxml.jackson.core/jackson-databind/${jackson2-databind.version}</documentation.jackson2-databind-javadoc-url>
		<documentation.jackson3-databind-javadoc-url>https://javadoc.io/doc/tools.jackson.core/jackson-databind/${jackson-databind.version}</documentation.jackson3-databind-javadoc-url>
		<documentation.jspecify-javadoc-url>https://jspecify.dev/docs/api/</documentation.jspecify-javadoc-url>
		<documentation.spring-security-javadoc-url>${documentation.baseurl}/spring-security/site/docs/current/api</documentation.spring-security-javadoc-url>
		<javadoc.offline-links.directory>${project.build.directory}/javadoc-offline-links</javadoc.offline-links.directory>

		<!-- Enabled only in CI and distribute profiles -->
		<javadoc.offline-links.skip>true</javadoc.offline-links.skip>
		<!-- @formatter:on -->
	</properties>

	<inceptionYear>2016</inceptionYear>

	<organization>
		<name>Pivotal Software, Inc.</name>
		<url>https://www.spring.io</url>
	</organization>

	<scm>
		<url>https://github.com/spring-projects/spring-vault</url>
		<connection>scm:git:git://github.com/spring-projects/spring-vault.git</connection>
		<developerConnection>
			scm:git:ssh://git@github.com/spring-projects/spring-vault.git
		</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/spring-projects/spring-vault/issues</url>
	</issueManagement>

	<developers>
		<developer>
			<id>sgibb</id>
			<name>Spencer Gibb</name>
		</developer>
		<developer>
			<id>mpaluch</id>
			<name>Mark Paluch</name>
		</developer>
	</developers>

